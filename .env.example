OPEN_DART_API_KEY=your_opendart_key
DATA_GO_KR_SERVICE_KEY=your_data_go_kr_key
KRX_AUTH_KEY=your_krx_key
PORT=4173
CACHE_TTL_MINUTES=360
RATE_LIMIT_PER_MINUTE=60
# 기본값은 프로젝트 내부 data/companies.json입니다.
COMPANY_DATA_PATH=data/companies.json
ECOS_API_KEY=
FRED_API_KEY=
KOREA_EXIM_API_KEY=
# AI 길잡이는 기본적으로 무료 규칙 안내만 사용합니다. 유료 API는 명시적으로 켤 때만 호출합니다.
FINSCOPE_AI_ENABLED=false
OPENAI_API_KEY=
FINSCOPE_AI_MODEL=gpt-6-luna
# 인스턴스당 시험 호출 수입니다. 공개 배포의 총비용 상한은 아닙니다.
FINSCOPE_AI_DAILY_LIMIT=1
